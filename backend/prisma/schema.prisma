// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentMethod {
  EWALLET
  BANK_CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  imageUrl        String?
  basePrice       Float
  sizeUpchargeM   Float?   // Ghi đè phụ thu Size M riêng cho món (null = dùng giá chuẩn toàn quán)
  sizeUpchargeL   Float?   // Ghi đè phụ thu Size L riêng cho món (null = dùng giá chuẩn toàn quán)
  category        String   @default("vietnamese") // vietnamese | espresso | tea | coldbrew | bakery
  tag             String?  @default("Phổ biến")
  isActive        Boolean  @default(true)         // Hiển thị trên trang /menu khách hàng
  isSoldOutManual Boolean  @default(false)        // Báo hết hàng thủ công bởi Admin
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  recipes         Recipe[]
}

model Ingredient {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  name           String
  unit           String
  stock          Float           @default(0)
  minThreshold   Float           @default(100)
  costPerUnit    Float           @default(0) // Đơn giá nhập (VNĐ / 1 đơn vị g, ml, chiếc...)
  version        Int             @default(0) // Optimistic Locking chống bán vượt tồn kho
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  recipes        Recipe[]
  toppingRecipes ToppingRecipe[]
  logs           InventoryLog[]
}

model InventoryLog {
  id             Int        @id @default(autoincrement())
  ingredientId   Int
  ingredientName String
  unit           String
  type           String     @default("RESTOCK") // RESTOCK | ADJUST
  changeAmount   Float
  previousStock  Float
  newStock       Float
  unitCost       Float      @default(0)
  totalCost      Float      @default(0)
  note           String?
  performedBy    String?
  createdAt      DateTime   @default(now())
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  size         String     @default("ALL") // S, M, L hoặc ALL (đối với bánh ngọt nhập về)
  amount       Float
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId, size])
}

model ToppingRecipe {
  id           Int        @id @default(autoincrement())
  toppingId    String     // boba, cream, jelly, shot...
  toppingName  String
  subtext      String?    @default("Topping thơm ngon chuẩn vị")
  price        Float      @default(8000)
  isActive     Boolean    @default(true)
  ingredientId Int
  amount       Float
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([toppingId, ingredientId])
}

model StoreSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model DiscountCode {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  description     String?
  discountPercent Float
  minOrderAmount  Float    @default(0)
  maxDiscountAmount Float?   // Mức giảm tối đa (VNĐ)
  isActive        Boolean  @default(true)
  usageCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  fullName      String?
  phone         String?
  position      String?       @default("Barista Pha Chế")
  isActive      Boolean       @default(true)
  role          Role          @default(CUSTOMER)
  loyaltyPoints Int           @default(0)   // Task 10: Điểm Hạt Vàng tích lũy
  createdAt     DateTime      @default(now())
  orders        Order[]
  vouchers      UserVoucher[]
}

model UserVoucher {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String
  quantity        Int      @default(1)
  discountPercent Float
  minOrderAmount  Float    @default(0)
  maxDiscountAmount Float?   // Mức giảm tối đa (VNĐ)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([userId, code])
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         Int?        // nullable: cho phép test trước khi có auth (Task 7)
  user           User?       @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDING)
  totalAmount    Float
  discountCode   String?
  discountAmount Float       @default(0)
  voucherDeducted Boolean    @default(false)
  version        Int         @default(0)   // Task 10: Optimistic Locking
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  staffId        Int?
  staffName      String?
  items          OrderItem[]
  payments       Payment[]
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  productName String
  size        String
  toppings    String[] // danh sách tên topping
  quantity    Int
  unitPrice   Float
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  order          Order         @relation(fields: [orderId], references: [id])
  idempotencyKey String?       @unique
  amount         Float
  method         PaymentMethod
  status         PaymentStatus
  createdAt      DateTime      @default(now())
}
